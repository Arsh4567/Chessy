{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user profile information excluding PII",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 64 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "multiplayerRating": { "type": "number" },
        "multiplayerGamesPlayed": { "type": "number" },
        "puzzleRating": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "displayName"]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Private sensitive user account information",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "UserStats": {
      "title": "UserStats",
      "description": "Detailed chess statistics, match history, and Elo ratings for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "gamesPlayed": { "type": "number" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "draws": { "type": "number" },
        "puzzleRating": { "type": "number" },
        "puzzlesSolved": { "type": "number" },
        "multiplayerRating": { "type": "number" },
        "multiplayerGamesPlayed": { "type": "number" },
        "multiplayerWins": { "type": "number" },
        "multiplayerLosses": { "type": "number" },
        "multiplayerDraws": { "type": "number" },
        "multiplayerPeakRating": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "multiplayerRating", "multiplayerGamesPlayed"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User chess board and engine preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "boardTheme": { "type": "string", "maxLength": 32 },
        "stockfishLevel": { "type": "number" },
        "engineThinkingSeconds": { "type": "number" },
        "soundEnabled": { "type": "boolean" },
        "showCoordinates": { "type": "boolean" },
        "showLegalMoves": { "type": "boolean" },
        "autoQueen": { "type": "boolean" },
        "defaultTimeControl": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "MultiplayerMatch": {
      "title": "MultiplayerMatch",
      "description": "Record of a completed multiplayer match",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "roomId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "opponentName": { "type": "string", "maxLength": 64 },
        "opponentRating": { "type": "number" },
        "ratingBefore": { "type": "number" },
        "ratingAfter": { "type": "number" },
        "ratingDelta": { "type": "number" },
        "isProvisional": { "type": "boolean" },
        "matchNumber": { "type": "number" },
        "result": { "type": "string", "enum": ["win", "loss", "draw"] },
        "movesCount": { "type": "number" },
        "pgn": { "type": "string", "maxLength": 8192 },
        "date": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "roomId", "userId", "result", "ratingBefore", "ratingAfter"]
    },
    "PublicLeaderboardEntry": {
      "title": "PublicLeaderboardEntry",
      "description": "Public real-time multiplayer leaderboard entry for each registered player",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 64 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "multiplayerRating": { "type": "number" },
        "multiplayerGamesPlayed": { "type": "number" },
        "multiplayerWins": { "type": "number" },
        "multiplayerLosses": { "type": "number" },
        "multiplayerDraws": { "type": "number" },
        "puzzleRating": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "displayName", "multiplayerRating"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Established friend relationship between two users",
      "type": "object",
      "properties": {
        "friendId": { "type": "string", "maxLength": 128 },
        "friendDisplayName": { "type": "string", "maxLength": 64 },
        "friendPhotoURL": { "type": "string", "maxLength": 512 },
        "friendRating": { "type": "number" },
        "addedAt": { "type": "string" }
      },
      "required": ["friendId", "friendDisplayName"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Pending, accepted, or declined friend request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fromUserId": { "type": "string", "maxLength": 128 },
        "fromDisplayName": { "type": "string", "maxLength": 64 },
        "fromPhotoURL": { "type": "string", "maxLength": 512 },
        "fromRating": { "type": "number" },
        "toUserId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "fromUserId", "toUserId", "status"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "1-on-1 direct chat message between friends",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 256 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderDisplayName": { "type": "string", "maxLength": 64 },
        "senderPhotoURL": { "type": "string", "maxLength": 512 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "chatId", "senderId", "recipientId", "text", "createdAt"]
    },
    "GameChallenge": {
      "title": "GameChallenge",
      "description": "Direct match challenge between two friends",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "challengerId": { "type": "string", "maxLength": 128 },
        "challengerDisplayName": { "type": "string", "maxLength": 64 },
        "challengerPhotoURL": { "type": "string", "maxLength": 512 },
        "challengerRating": { "type": "number" },
        "challengedId": { "type": "string", "maxLength": 128 },
        "timeControl": { "type": "string", "maxLength": 32 },
        "challengerColor": { "type": "string", "enum": ["w", "b", "random"] },
        "isRated": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "cancelled", "expired"] },
        "roomId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "challengerId", "challengedId", "timeControl", "status"]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Live online presence and in-game activity indicator",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["online", "in-game", "offline"] },
        "currentRoomId": { "type": "string", "maxLength": 64 },
        "lastActive": { "type": "string" }
      },
      "required": ["userId", "status", "lastActive"]
    }
  },
  "firestore": {
    "users": {
      "description": "Root user directory containing profiles, private accounts, and stats",
      "subcollections": {
        "profile": { "description": "Public profile of user" },
        "private": { "description": "Private sensitive info of user" },
        "stats": { "description": "Current stats and rating history" },
        "preferences": { "description": "User preferences" },
        "matches": { "description": "Multiplayer match history records" },
        "friends": { "description": "Friend list of user" }
      }
    },
    "public_leaderboard": {
      "description": "Public read-only real-time multiplayer leaderboard entries"
    },
    "friend_requests": {
      "description": "Pending and resolved friend requests between users"
    },
    "direct_chats": {
      "description": "Direct chat rooms between pairs of users",
      "subcollections": {
        "messages": { "description": "Direct messages in the chat" }
      }
    },
    "game_challenges": {
      "description": "Direct game challenges between friends"
    },
    "user_presence": {
      "description": "Real-time user presence and online status"
    }
  }
}
